# Opportunity Radar - Environment Variables
# SerpApi Key for live search engines (Scholar, Patents, Jobs, News, Shopping, Trends)
SERPAPI_KEY=your_serpapi_api_key_here

# LLM API Key for grounded AI summaries (Google Gemini API key)
LLM_API_KEY=your_gemini_api_key_here

# Backend URL used by frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend CORS Allowed Origins (comma-separated or single)
CORS_ORIGIN=http://localhost:3000
